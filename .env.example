# ============================================================================
# Configuración del ETL Odoo.sh → PostgreSQL
# Copiar a .env y rellenar con valores reales:
#   cp .env.example .env
# ============================================================================

# -- Odoo.sh (origen) -------------------------------------------------------
# URL de tu instancia Odoo.sh (sin slash final)
ODOO_URL=https://mycompany.odoo.com

# Nombre de la base de datos (ver en Odoo.sh → Database name)
ODOO_DB=mycompany-main-12345678

# Usuario con permisos de lectura
ODOO_USER=admin

# Contraseña o API Key (recomendado: usar API Key desde Odoo → Settings → API Keys)
ODOO_PASSWORD=tu_api_key_aqui

# -- PostgreSQL local (destino) ----------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=odoo_bi
PG_USER=bi_user
PG_PASSWORD=tu_password_pg_aqui

# -- ETL opciones ------------------------------------------------------------
# Registros por lote en lectura XML-RPC
ETL_BATCH_SIZE=500

# Máximo de registros por modelo (0 = sin límite)
ETL_MAX_RECORDS=0

# Nivel de log: DEBUG, INFO, WARNING, ERROR
ETL_LOG_LEVEL=INFO
